# Copy to terraform.tfvars (git-ignored) and edit.

repo_url   = "https://github.com/YOUR_USER/cloudrescue.git"
repo_ref   = "main"

# Your public IP, from:  curl -s https://checkip.amazonaws.com
admin_cidr = "203.0.113.7/32"

# ssh-keygen -t ed25519 -f ~/.ssh/cloudrescue
ssh_public_key_path = "~/.ssh/cloudrescue.pub"

# aws_region           = "us-east-1"
# instance_type        = "t3.small"
# expose_grafana       = false      # safer: use the SSH tunnel instead
# enable_l2_reboot     = false      # see docs/security.md before enabling
# iam_instance_profile = "LabInstanceProfile"
