# Copy to .env (or run `make init`, which also generates strong random values).
# .env is git-ignored. NEVER commit real secrets.

# Token required by the demo-service chaos endpoint (POST /fail).
CHAOS_TOKEN=change-me-change-me-change-me
# Shared secret between monitor and docker-guard (>= 16 characters).
GUARD_TOKEN=change-me-change-me-change-me
GRAFANA_ADMIN_PASSWORD=change-me-change-me-change-me

# Group id of the host's "docker" group:  getent group docker | cut -d: -f3
DOCKER_GID=999

# Containers docker-guard may restart (comma separated). This is the security boundary.
ALLOWED_CONTAINERS=demo-service

# 127.0.0.1 = reachable only from the host (use an SSH tunnel). 0.0.0.0 = all interfaces
# (only do this behind a restrictive security group).
GRAFANA_BIND=127.0.0.1

# Enable host metrics containers: COMPOSE_PROFILES=host-metrics
COMPOSE_PROFILES=

# Level-2 escalation (reboot the EC2 VM). Read docs/security.md before enabling.
MONITOR_WITH_AWS=false
ESCALATION_EC2_REBOOT=false
