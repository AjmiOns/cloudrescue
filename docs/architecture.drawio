<mxfile host="app.diagrams.net"><diagram name="CloudRescue AWS Architecture" id="cr2"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="CloudRescue - Self-Healing Cloud Infrastructure on AWS (Learner Lab)" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1500" height="36" as="geometry"/></mxCell><mxCell id="st" value="AWS reference architecture: Region &gt; VPC &gt; Availability Zone &gt; public subnet &gt; Security Group &gt; EC2 &gt; Docker Compose | detect, diagnose, recover, verify, log, observe" style="text;html=1;fontSize=13;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1800" height="24" as="geometry"/></mxCell><mxCell id="ws" value="Developer workstation (Ubuntu / WSL2)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=group_corporate_data_center;strokeColor=#5A6C86;fillColor=#F7F8FA;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="270" height="300" as="geometry"/></mxCell><mxCell id="tf" value="&lt;b&gt;Terraform CLI&lt;/b&gt;&lt;br&gt;init, plan, apply, destroy&lt;br&gt;local tfstate (git-ignored)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="ws"><mxGeometry x="15" y="50" width="240" height="70" as="geometry"/></mxCell><mxCell id="ssh" value="&lt;b&gt;Browser + SSH client&lt;/b&gt;&lt;br&gt;key-based auth, no passwords" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#5A6C86;" vertex="1" parent="ws"><mxGeometry x="15" y="140" width="240" height="60" as="geometry"/></mxCell><mxCell id="creds" value="&lt;b&gt;~/.aws/credentials&lt;/b&gt;&lt;br&gt;Learner Lab temp keys + token&lt;br&gt;(expire each session, never committed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#5A6C86;" vertex="1" parent="ws"><mxGeometry x="15" y="218" width="240" height="70" as="geometry"/></mxCell><mxCell id="gh" value="&lt;b&gt;GitHub repo: cloudrescue&lt;/b&gt;&lt;br&gt;.gitignore: *.tfstate, *.pem, .env, creds" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="270" height="70" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;CI (GitHub Actions)&lt;/b&gt;&lt;br&gt;pytest, ruff, tflint, tfsec / checkov,&lt;br&gt;docker build, compose smoke test" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#F4E3F7;strokeColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="270" height="90" as="geometry"/></mxCell><mxCell id="sm" value="&lt;b&gt;Recovery state machine&lt;/b&gt;&lt;br&gt;HEALTHY &gt; SUSPECT (1 miss)&lt;br&gt;&gt; FAILED (3 consecutive misses)&lt;br&gt;&gt; RECOVERING (restart request)&lt;br&gt;&gt; VERIFY (healthy within 30 s?)&lt;br&gt;OK: RESOLVED &gt; HEALTHY&lt;br&gt;KO: ESCALATE (max 3 restarts / 10 min,&lt;br&gt;cooldown 60 s) &gt; L2 EC2 reboot / alert" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;align=left;spacingLeft=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="270" height="200" as="geometry"/></mxCell><mxCell id="inet" value="Internet" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet;" vertex="1" parent="1"><mxGeometry x="345" y="468" width="56" height="56" as="geometry"/></mxCell><mxCell id="aws" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="1460" height="810" as="geometry"/></mxCell><mxCell id="reg" value="Region us-east-1 (AWS Academy Learner Lab)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=group_region;strokeColor=#147EBA;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="aws"><mxGeometry x="20" y="40" width="1420" height="750" as="geometry"/></mxCell><mxCell id="vpc" value="VPC 10.0.0.0/16" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="reg"><mxGeometry x="20" y="40" width="1130" height="690" as="geometry"/></mxCell><mxCell id="az" value="Availability Zone us-east-1a" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#147EBA;html=1;whiteSpace=wrap;fontSize=12;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;" vertex="1" parent="vpc"><mxGeometry x="40" y="40" width="1050" height="620" as="geometry"/></mxCell><mxCell id="sub" value="Public subnet 10.0.1.0/24" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=group_security_group;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="az"><mxGeometry x="30" y="50" width="990" height="540" as="geometry"/></mxCell><mxCell id="sg" value="Security Group: sg-cloudrescue" style="fillColor=none;strokeColor=#DD3522;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#DD3522;html=1;whiteSpace=wrap;fontSize=12;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;" vertex="1" parent="sub"><mxGeometry x="20" y="50" width="950" height="470" as="geometry"/></mxCell><mxCell id="ec2c" value="EC2 instance - Ubuntu 22.04 - t3.small" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=group_ec2_instance_contents;strokeColor=#D86613;fillColor=#FFF8F0;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D86613;dashed=0;" vertex="1" parent="sg"><mxGeometry x="20" y="40" width="910" height="400" as="geometry"/></mxCell><mxCell id="net" value="Docker Compose network: cloudrescue-net" style="fillColor=none;strokeColor=#2496ED;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#1565A8;html=1;whiteSpace=wrap;fontSize=12;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;" vertex="1" parent="ec2c"><mxGeometry x="20" y="40" width="870" height="330" as="geometry"/></mxCell><mxCell id="igw" value="Internet Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="vpc"><mxGeometry x="-24" y="302" width="48" height="48" as="geometry"/></mxCell><mxCell id="eip" value="&lt;b&gt;Elastic IP&lt;/b&gt; (stable address)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#E6DCFA;strokeColor=#8C4FFF;fontSize=10;" vertex="1" parent="sub"><mxGeometry x="620" y="8" width="170" height="32" as="geometry"/></mxCell><mxCell id="rt" value="&lt;b&gt;Route&lt;/b&gt; 0.0.0.0/0 &gt; IGW" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#E6DCFA;strokeColor=#8C4FFF;fontSize=10;" vertex="1" parent="sub"><mxGeometry x="800" y="8" width="180" height="32" as="geometry"/></mxCell><mxCell id="demo" value="&lt;b&gt;demo-service&lt;/b&gt;&lt;br&gt;FastAPI :8000&lt;br&gt;/health /fail /metrics&lt;br&gt;non-root, read-only FS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="net"><mxGeometry x="15" y="30" width="170" height="105" as="geometry"/></mxCell><mxCell id="mon" value="&lt;b&gt;monitor (CloudRescue core)&lt;/b&gt;&lt;br&gt;health_check.py&lt;br&gt;recovery.py (allowlist + cooldown)&lt;br&gt;incident_logger.py&lt;br&gt;/metrics :8001" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="net"><mxGeometry x="225" y="30" width="215" height="130" as="geometry"/></mxCell><mxCell id="prom" value="&lt;b&gt;Prometheus&lt;/b&gt; :9090&lt;br&gt;scrape 15 s&lt;br&gt;alert rules, retention 7 d" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="net"><mxGeometry x="480" y="30" width="170" height="105" as="geometry"/></mxCell><mxCell id="graf" value="&lt;b&gt;Grafana&lt;/b&gt; :3000&lt;br&gt;availability, MTTR,&lt;br&gt;restarts, incidents" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="net"><mxGeometry x="690" y="30" width="170" height="105" as="geometry"/></mxCell><mxCell id="dmn" value="&lt;b&gt;Docker daemon&lt;/b&gt;&lt;br&gt;/var/run/docker.sock&lt;br&gt;(root-owned, never mounted into monitor)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="net"><mxGeometry x="15" y="210" width="170" height="105" as="geometry"/></mxCell><mxCell id="prx" value="&lt;b&gt;docker-guard&lt;/b&gt;&lt;br&gt;ALLOW: list / inspect / restart&lt;br&gt;DENY: exec, create, run, volumes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;" vertex="1" parent="net"><mxGeometry x="225" y="210" width="215" height="105" as="geometry"/></mxCell><mxCell id="vol" value="&lt;b&gt;Incident store&lt;/b&gt;&lt;br&gt;SQLite / JSONL&lt;br&gt;Docker volume /data" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="net"><mxGeometry x="480" y="210" width="170" height="105" as="geometry"/></mxCell><mxCell id="cadv" value="&lt;b&gt;cAdvisor + node-exporter&lt;/b&gt;&lt;br&gt;container / host metrics&lt;br&gt;(read-only mounts)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="net"><mxGeometry x="690" y="210" width="170" height="105" as="geometry"/></mxCell><mxCell id="ec2api" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="reg"><mxGeometry x="1180" y="35" width="56" height="56" as="geometry"/></mxCell><mxCell id="ec2api_t" value="&lt;b&gt;Amazon EC2 API&lt;/b&gt;&lt;br&gt;RebootInstances (level-2 recovery)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="reg"><mxGeometry x="1244" y="31" width="170" height="64" as="geometry"/></mxCell><mxCell id="iam" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="reg"><mxGeometry x="1180" y="150" width="56" height="56" as="geometry"/></mxCell><mxCell id="iam_t" value="&lt;b&gt;IAM LabInstanceProfile&lt;/b&gt;&lt;br&gt;pre-provisioned, no role/user creation" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="reg"><mxGeometry x="1244" y="146" width="170" height="64" as="geometry"/></mxCell><mxCell id="s3" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="reg"><mxGeometry x="1180" y="265" width="56" height="56" as="geometry"/></mxCell><mxCell id="s3_t" value="&lt;b&gt;Amazon S3 (optional)&lt;/b&gt;&lt;br&gt;remote tfstate + locking" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="reg"><mxGeometry x="1244" y="261" width="170" height="64" as="geometry"/></mxCell><mxCell id="bud" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;" vertex="1" parent="reg"><mxGeometry x="1180" y="380" width="56" height="56" as="geometry"/></mxCell><mxCell id="bud_t" value="&lt;b&gt;AWS Budgets&lt;/b&gt;&lt;br&gt;billing alert, stop lab when idle" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="reg"><mxGeometry x="1244" y="376" width="170" height="64" as="geometry"/></mxCell><mxCell id="cw" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="reg"><mxGeometry x="1180" y="495" width="56" height="56" as="geometry"/></mxCell><mxCell id="cw_t" value="&lt;b&gt;Amazon CloudWatch (optional)&lt;/b&gt;&lt;br&gt;EC2 status-check alarm" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="reg"><mxGeometry x="1244" y="491" width="170" height="64" as="geometry"/></mxCell><mxCell id="ssm" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="reg"><mxGeometry x="1180" y="610" width="56" height="56" as="geometry"/></mxCell><mxCell id="ssm_t" value="&lt;b&gt;Systems Manager (optional)&lt;/b&gt;&lt;br&gt;Session Manager instead of open SSH, Parameter Store for secrets" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="reg"><mxGeometry x="1244" y="606" width="170" height="64" as="geometry"/></mxCell><mxCell id="e1" value="(1) GET /health" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="mon" target="demo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="(2) restart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mon" target="prx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="(3) POST /restart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="prx" target="dmn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="(4) restart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="dmn" target="demo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="(5) incident" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="mon" target="vol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="(6) scrape" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#D79B00;exitX=0;exitY=0.35;entryX=1;entryY=0.35;" edge="1" parent="1" source="prom" target="mon"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="(7) PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#D79B00;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="graf" target="prom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="(8) L2 escalation (boto3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#DD344C;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="mon" target="ec2api"><mxGeometry relative="1" as="geometry" x="0.6"><Array as="points"><mxPoint x="982.5" y="193"/></Array></mxGeometry></mxCell><mxCell id="e9" value="instance profile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#DD344C;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.1;" edge="1" parent="1" source="iam" target="ec2c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea" value="admin access" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="ssh" target="inet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb" value="SSH 22 / Grafana 3000 (admin /32 only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inet" target="igw"><mxGeometry relative="1" as="geometry" y="-30"></mxGeometry></mxCell><mxCell id="ec" value="terraform apply (HTTPS / AWS API)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;exitX=1;exitY=0.5;entryX=0;entryY=0.12;" edge="1" parent="1" source="tf" target="aws"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed" value="git push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ws" target="gh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ee" value="triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gh" target="ci"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ef" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#8C4FFF;exitX=1;exitY=0.5;entryX=0;entryY=0.08;" edge="1" parent="1" source="igw" target="sg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow" value="&lt;b&gt;Data and control flow&lt;/b&gt;&lt;br&gt;(1) monitor polls demo-service /health every 5 s (timeout 2 s).&lt;br&gt;(2) after 3 consecutive failures, recovery.py asks docker-guard to restart (never touches docker.sock directly).&lt;br&gt;(3) proxy forwards only POST /containers/{allowlisted-name}/restart to the Docker daemon.&lt;br&gt;(4) daemon restarts the container; monitor re-checks health for 30 s to VERIFY recovery.&lt;br&gt;(5) outcome (success / failure, attempts, MTTR) is written to the incident store.&lt;br&gt;(6) Prometheus scrapes monitor :8001, demo-service /metrics, cAdvisor, node-exporter every 15 s.&lt;br&gt;(7) Grafana queries Prometheus: availability %, MTTR, restart count, incident timeline.&lt;br&gt;(8) optional level 2: after max retries, boto3 reboots the EC2 instance via the instance profile (EC2 API)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="930" width="950" height="235" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;Security controls (AWS shared-responsibility view)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Network:&lt;/b&gt; SG inbound only 22 and 3000 from admin_ip/32; 8000, 8001, 9090 stay inside the Docker network.&lt;br&gt;&lt;b&gt;Identity:&lt;/b&gt; LabInstanceProfile only (Learner Lab forbids IAM creation); SSH key pair, password login disabled.&lt;br&gt;&lt;b&gt;Containers:&lt;/b&gt; docker-guard allowlist, non-root, read-only rootfs, cap_drop ALL, CPU/memory limits, no privileged.&lt;br&gt;&lt;b&gt;Host:&lt;/b&gt; IMDSv2 required, encrypted EBS (gp3), unattended-upgrades, ufw / fail2ban (optional).&lt;br&gt;&lt;b&gt;Secrets:&lt;/b&gt; git-ignored .env or Parameter Store; credentials and *.pem never in Git; tfsec / checkov in CI.&lt;br&gt;&lt;b&gt;Governance:&lt;/b&gt; resource tags, AWS Budgets alert, incident log + Docker logs as audit trail, terraform destroy when done.&lt;br&gt;&lt;b&gt;Blast radius:&lt;/b&gt; monitor restarts only named containers; escalation limited to this one instance." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FDEDEC;strokeColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="990" y="930" width="950" height="235" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>